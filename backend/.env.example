# ---- Servidor ----
NODE_ENV=development
PORT=4000
# URL pública do frontend (usada em links de e-mail e CORS)
APP_URL=http://localhost:3000

# ---- Banco de dados (PostgreSQL / Supabase) ----
DATABASE_URL=postgres://vendas:vendas@localhost:5432/vendas_de_simples

# ---- Autenticação ----
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ---- Regras do curso ----
# true = Sessão N só libera após 100% da Sessão N-1
SEQUENTIAL_UNLOCK=true
# Exibe marca d'água com o e-mail do aluno sobre o player
WATERMARK_ENABLED=true
TERMS_VERSION=2026-09

# ---- Vídeos (Bunny.net Stream / CDN com Token Authentication) ----
# Deixe em branco para usar o stream HLS de demonstração.
VIDEO_CDN_BASE_URL=
VIDEO_TOKEN_SECRET=
VIDEO_TOKEN_TTL_SECONDS=3600
VIDEO_DEMO_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# ---- E-mails transacionais (resend | sendgrid | console) ----
EMAIL_PROVIDER=console
EMAIL_FROM="Vendas de Simples <nao-responda@seudominio.com.br>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---- Dados da empresa (certificado / e-mails) ----
PRODUCT_NAME=Vendas de Simples
SUPPORT_EMAIL=suporte@seudominio.com.br
